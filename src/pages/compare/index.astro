---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getComparisons } from '../../lib/compare';
import { formatDate } from '../../lib/prices';

const comparisons = getComparisons();
---
<BaseLayout title="카테고리별 가격 비교" description="쿠팡 인기 상품의 가격과 배송 조건을 카테고리별로 비교합니다.">
  <h1>카테고리별 가격 비교</h1>
  <p>카테고리마다 쿠팡 검색 상위 상품의 가격을 매일 기록하고 비교합니다.</p>

  {comparisons.length === 0 ? (
    <p class="muted">비교 데이터를 모으는 중입니다. 곧 카테고리별 비교 페이지가 열립니다.</p>
  ) : (
    comparisons.map((c) => (
      <article class="post-list-item">
        <h2><a href={`/compare/${c.slug}/`}>{c.topic} 인기 상품 TOP {c.products.length} 가격 비교</a></h2>
        <p class="post-meta">{formatDate(c.updatedAt)} 업데이트</p>
      </article>
    ))
  )}
</BaseLayout>
