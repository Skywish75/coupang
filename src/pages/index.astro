---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getComparisons } from '../lib/compare';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 5);

const comparisons = getComparisons();
---
<BaseLayout
  title="7mall.kr - 상품 비교 & 가격 정보"
  description="쿠팡 인기 상품의 특징과 가격 추이를 정리하고 카테고리별로 비교하는 7mall.kr입니다."
>
  <h1>7mall.kr</h1>
  <p>쿠팡 인기 상품의 특징을 정리하고, 매일 기록한 가격으로 지금 사도 괜찮은 가격인지 비교해 드립니다.</p>

  {comparisons.length > 0 && (
    <>
      <h2>카테고리별 가격 비교</h2>
      <ul class="related-list">
        {comparisons.map((c) => (
          <li><a href={`/compare/${c.slug}/`}>{c.topic} 인기 상품 TOP {c.products.length} 가격 비교</a></li>
        ))}
      </ul>
    </>
  )}

  <h2>최신 글</h2>
  {posts.map((post) => (
    <article class="post-list-item">
      <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
      <p class="post-meta">{post.data.pubDate.toLocaleDateString('ko-KR')}</p>
      <p>{post.data.description}</p>
    </article>
  ))}
</BaseLayout>
